# ==============================================================================
# Variables de Entorno para Odoo + PostgreSQL (Local y Docker Compose)
# ==============================================================================

# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_secure_password_2026

# Configuración Maestra de Odoo (Master Password para crear/restaurar BDs)
ODOO_ADMIN_PASSWORD=admin_super_secret_master_key

# Puertos expuestos en el Host
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# Dominio para Ingress (K3s / K8s)
DOMAIN_NAME=odoo.local
