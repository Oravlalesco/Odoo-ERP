<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WM-012: WMS Storage Type Administration UI
         List, Form, Search, Action, Menu
         ============================================================ -->

    <!-- ==================== List View ==================== -->

    <record id="view_wms_storage_type_list" model="ir.ui.view">
        <field name="name">wms.storage.type.list</field>
        <field name="model">wms.storage.type</field>
        <field name="arch" type="xml">
            <list string="WMS Storage Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ==================== Form View ==================== -->

    <record id="view_wms_storage_type_form" model="ir.ui.view">
        <field name="name">wms.storage.type.form</field>
        <field name="model">wms.storage.type</field>
        <field name="arch" type="xml">
            <form string="WMS Storage Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Nombre del tipo de almacenamiento"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== Search View ==================== -->

    <record id="view_wms_storage_type_search" model="ir.ui.view">
        <field name="name">wms.storage.type.search</field>
        <field name="model">wms.storage.type</field>
        <field name="arch" type="xml">
            <search string="Buscar tipos de almacenamiento WMS">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <filter name="inactive"
                        string="Archivados"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_company"
                            string="Compañía"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== Action ==================== -->

    <record id="action_wms_storage_type" model="ir.actions.act_window">
        <field name="name">WMS Storage Types</field>
        <field name="res_model">wms.storage.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wms_storage_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un tipo de almacenamiento WMS
            </p>
            <p>
                Los tipos de almacenamiento describen la infraestructura
                física de las ubicaciones: racks de pallets, estanterías,
                piso, cámara fría, etc.
            </p>
        </field>
    </record>

    <!-- ==================== Menu ==================== -->

    <menuitem id="menu_wms_storage_type"
              name="WMS Storage Types"
              parent="stock.menu_warehouse_config"
              action="action_wms_storage_type"
              groups="wms_core.group_wms_manager,base.group_system"
              sequence="52"/>

</odoo>
