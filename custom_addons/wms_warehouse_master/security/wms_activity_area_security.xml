<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        WM-008: Record rule multi-company para wms.activity.area.
        Aislamiento por compañías permitidas del usuario.
        Usa company_ids (plural) para soportar usuarios
        con múltiples compañías habilitadas.
    -->

    <record id="wms_activity_area_company_rule" model="ir.rule">
        <field name="name">WMS Activity Area: multi-company isolation</field>
        <field name="model_id" ref="model_wms_activity_area"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
