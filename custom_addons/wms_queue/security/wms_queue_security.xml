<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-compañía global -->
        <record id="wms_queue_company_rule" model="ir.rule">
            <field name="name">wms.queue: regla multi-compañía</field>
            <field name="model_id" ref="model_wms_queue"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
