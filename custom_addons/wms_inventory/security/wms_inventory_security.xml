<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         INV-002: WMS Inventory Block Multi-Company Record Rule
         ============================================================ -->

    <record id="rule_wms_inventory_block_company" model="ir.rule">
        <field name="name">WMS Inventory Block: multi-company</field>
        <field name="model_id" ref="model_wms_inventory_block"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ============================================================
         INV-008: Regla de registro multi-compañía para Eventos de Inventario
         ============================================================ -->

    <record id="rule_wms_inventory_event_company" model="ir.rule">
        <field name="name">Evento de Inventario WMS: multi-compañía</field>
        <field name="model_id" ref="model_wms_inventory_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ============================================================
         INV-010A: Regla de registro multi-compañía para Outbox Transaccional
         ============================================================ -->

    <record id="rule_wms_outbox_company" model="ir.rule">
        <field name="name">Bandeja de Salida WMS: multi-compañía</field>
        <field name="model_id" ref="model_wms_outbox"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
