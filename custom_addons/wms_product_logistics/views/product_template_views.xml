<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         PLM-007C: Product Template Contextual Action & Stat Button
         Acceso contextual desde product.template a wms.product.logistics
         ============================================================ -->

    <!-- Acción contextual dedicada desde product.template -->
    <record id="action_wms_product_logistics_from_product" model="ir.actions.act_window">
        <field name="name">Perfil logístico WMS</field>
        <field name="res_model">wms.product.logistics</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wms_product_logistics_search"/>
        <field name="domain">[('product_tmpl_id', '=', active_id)]</field>
        <field name="context">{
            'default_product_tmpl_id': active_id,
            'active_test': False,
        }</field>
    </record>

    <!-- Herencia de vista de formulario de product.template para stat button -->
    <record id="view_product_template_form_wms_logistics" model="ir.ui.view">
        <field name="name">product.template.form.wms.logistics</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_wms_product_logistics_from_product)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-truck"
                        string="Logística WMS"
                        invisible="not id"
                        groups="wms_core.group_wms_operator,base.group_system"/>
            </xpath>
        </field>
    </record>

</odoo>
