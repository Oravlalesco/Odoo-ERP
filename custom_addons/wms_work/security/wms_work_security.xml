<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WORK-002: WMS Work Multi-Company Global Record Rule
         ============================================================ -->

    <record id="rule_wms_work_company" model="ir.rule">
        <field name="name">WMS Work: multi-company</field>
        <field name="model_id" ref="model_wms_work"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ============================================================
         WORK-002: WMS Work Line Multi-Company Global Record Rule
         ============================================================ -->

    <record id="rule_wms_work_line_company" model="ir.rule">
        <field name="name">WMS Work Line: multi-company</field>
        <field name="model_id" ref="model_wms_work_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
